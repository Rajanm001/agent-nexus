# AgentNexus Configuration
# Copy this to .env and fill in your keys

# Required
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Optional (uses FAISS locally if not set)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# Database (auto-configured with Docker)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/agentnexus
REDIS_URL=redis://localhost:6379/0

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
